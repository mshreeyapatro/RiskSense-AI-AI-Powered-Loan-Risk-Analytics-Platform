# Copy this file to .env and fill in real values. Never commit .env.

# Flask session signing key. Optional for local single-process runs (a random
# key is auto-generated if unset, with a warning) but REQUIRED for production
# or any multi-worker deployment (e.g. gunicorn) — otherwise each worker gets
# its own random key and session cookies fail validation across workers.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to "true" only for local development. Enables Flask debug mode.
FLASK_DEBUG=false
